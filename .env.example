# Copie para .env e escolha o provedor: openai | ollama | fake
LLM_PROVIDER=openai

# --- OpenAI (ou qualquer API compatível, via OPENAI_BASE_URL) ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (local e gratuito) ---
# Com o Ollama instalado no Windows/Mac: http://host.docker.internal:11434
# Com o serviço do compose (--profile ollama): http://ollama:11434
# Rodando o back-end fora do Docker: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Dimensão dos vetores. Deixe vazio para usar o padrão do provedor (OpenAI 1536, Ollama 768).
# Mudar de provedor ou de modelo exige recriar o banco: docker compose down -v
# EMBEDDING_DIM=

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SEARCH_MODE=hybrid
MAX_UPLOAD_MB=25

# --- Acesso ---
# Primeiro administrador, criado quando o banco ainda não tem nenhum usuário.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
# Chave que assina os tokens de login. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-esta-chave
TOKEN_HOURS=8
